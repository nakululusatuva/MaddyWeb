[Unit]
Description=Twice-daily renewal check for the maddy.standalone.example.test Web certificate
Documentation=file:/opt/maddyweb/current/public-edge/public-edge.md

[Timer]
OnBootSec=20min
OnCalendar=*-*-* 03,15:17:00
RandomizedDelaySec=30min
AccuracySec=5min
Persistent=true
Unit=maddyweb-web-cert-standalone.service

[Install]
WantedBy=timers.target
