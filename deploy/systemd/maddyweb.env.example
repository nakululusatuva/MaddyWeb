# This file is configuration only. Never place passwords, API tokens, session
# secrets, or Maddy credentials in systemd environment files.

# Optional delivery-filter bridge location. The port is fixed; Docker mode may
# replace only the private IPv4 address after inspecting its bridge gateway.
MADDYWEB_FILTER_LISTEN=127.0.0.1:18787
MADDYWEB_CONFIG=/etc/maddyweb/config.toml
